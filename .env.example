# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# ---- Database (MySQL) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=educaze_hibernate
DB_USER=qlsv_app
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ---- JWT: chuỗi Base64 của ít nhất 32 byte ----
AUTH_JWT_SECRET=change_me_base64_32_bytes

# ---- MinIO ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_BUCKET=student-documents

# ---- Tạo admin/lecturer khi database CHƯA có (12-72 ký tự) ----
# Với dữ liệu demo trong db/init, admin/lecturer đã có sẵn nên 2 mật khẩu dưới không được dùng (xem README mục 5)
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me_12chars
APP_BOOTSTRAP_LECTURER_PASSWORD=change_me_12chars

# ---- Khác ----
SERVER_PORT=8082
JPA_SHOW_SQL=false
